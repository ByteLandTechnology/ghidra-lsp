    "viewsContainers": {
      "activitybar": [
        {
          "id": "ghidra",
          "title": "Ghidra",
          "icon": "resources/ghidra.svg"
        }
      ]
    },
    "views": {
      "ghidra": [
        {
          "id": "ghidra.sessions",
          "name": "Sessions",
          "visibility": "collapsed"
        },
        {
          "id": "ghidra.symbols",
          "name": "Symbols"
        },
        {
          "id": "ghidra.strings",
          "name": "Strings",
          "visibility": "collapsed"
        },
        {
          "id": "ghidra.types",
          "name": "Data Types"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ghidra.symbols",
        "contents": "Open a binary to start exploring its functions and symbols.\n[Open Binary](command:ghidraLsp.openBinary)\n[Open Recent Program](command:ghidraLsp.openRecent)\nOr [select an open session](command:ghidraLsp.selectSession).",
        "when": "!ghidra.browserHasProgram"
      },
      {
        "view": "ghidra.types",
        "contents": "Data types appear after you [open a binary](command:ghidraLsp.openBinary) or [select an open session](command:ghidraLsp.selectSession).",
        "when": "!ghidra.browserHasProgram"
      },
      {
        "view": "ghidra.strings",
        "contents": "Strings appear after you [open a binary](command:ghidraLsp.openBinary) or [select an open session](command:ghidraLsp.selectSession).",
        "when": "!ghidra.stringsHasProgram"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "ghidra-type:/**/*"
        ],
        "url": "./schemas/data-type.schema.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "ghidra.analysisControlFlow",
        "displayName": "Ghidra Control Flow",
        "selector": [
          {
            "filenamePattern": "ghidra-listing:/listing/*"
          }
        ],
        "priority": "option"
      },
      {
        "viewType": "ghidra.dataTypeEditor",
        "displayName": "Ghidra Data Type Editor",
        "selector": [
          {
            "filenamePattern": "ghidra-type:/**/*"
          }
        ],
        "priority": "option"
      }
    ]
