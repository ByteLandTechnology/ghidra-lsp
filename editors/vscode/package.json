{
  "name": "ghidra-lsp",
  "displayName": "Ghidra LSP",
  "description": "Browse and rename Ghidra symbols through ghidra-mcp",
  "version": "0.4.0",
  "publisher": "byteland-app",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ByteLandTechnology/ghidra-lsp.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/ByteLandTechnology/ghidra-lsp#readme",
  "bugs": {
    "url": "https://github.com/ByteLandTechnology/ghidra-lsp/issues"
  },
  "keywords": [
    "ghidra",
    "decompiler",
    "disassembly",
    "reverse-engineering",
    "lsp",
    "mcp"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onFileSystem:ghidra",
    "onFileSystem:ghidra-listing",
    "onFileSystem:ghidra-memory",
    "onLanguage:ghidra-decompiled",
    "onWebviewPanel:ghidra.programOverview",
    "onWebviewPanel:ghidra.dataType",
    "onWebviewPanel:ghidra.symbolDetails",
    "onWebviewPanel:ghidra.functionDetails",
    "onWebviewPanel:ghidra.listing",
    "onWebviewPanel:ghidra.memory",
    "onWebviewPanel:ghidra.strings",
    "onWebviewPanel:ghidra.imports",
    "onWebviewPanel:ghidra.exports",
    "onWebviewPanel:ghidra.callGraph",
    "onWebviewPanel:ghidra.controlFlow",
    "onWebviewPanel:ghidra.callers",
    "onWebviewPanel:ghidra.callees",
    "onWebviewPanel:ghidra.references",
    "onFileSystem:ghidra-type",
    "onCustomEditor:ghidra.analysisControlFlow",
    "onCustomEditor:ghidra.dataTypeEditor"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "contributes": {
    "configurationDefaults": {
      "[ghidra-listing]": {
        "editor.wordWrap": "on",
        "editor.wrappingIndent": "same"
      }
    },
    "resourceLabelFormatters": [
      {
        "scheme": "ghidra-reference",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "stripPathStartingSeparator": true
        }
      },
      {
        "scheme": "ghidra-listing",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "stripPathStartingSeparator": true
        }
      },
      {
        "scheme": "ghidra-memory",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "stripPathStartingSeparator": true
        }
      },
      {
        "scheme": "ghidra-type",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "stripPathStartingSeparator": true
        }
      }
    ],
    "languages": [
      {
        "id": "ghidra-decompiled",
        "aliases": [
          "Ghidra Decompilation"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ghidra-listing",
        "aliases": [
          "Ghidra Listing"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ghidra-memory",
        "aliases": [
          "Ghidra Bytes"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ghidra-decompiled",
        "scopeName": "source.ghidra-c",
        "path": "./syntaxes/ghidra.tmLanguage.json"
      },
      {
        "language": "ghidra-listing",
        "scopeName": "source.ghidra-listing",
        "path": "./syntaxes/ghidra-listing.tmLanguage.json"
      },
      {
        "language": "ghidra-memory",
        "scopeName": "source.ghidra-memory",
        "path": "./syntaxes/ghidra-memory.tmLanguage.json"
      }
    ],
