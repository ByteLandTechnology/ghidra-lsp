    "configuration": {
      "title": "Ghidra LSP",
      "properties": {
        "ghidraLsp.autoInstall": {
          "type": "boolean",
          "default": true,
          "description": "Automatically install missing default ghidra-lsp and ghidra-mcp binaries via npm into the shared user bin directory."
        },
        "ghidraLsp.serverPath": {
          "type": "string",
          "default": "ghidra-lsp",
          "description": "Path to the Rust language server. Leave at default to auto-resolve or install via npm. Restart the extension after changing settings."
        },
        "ghidraLsp.mcpCommand": {
          "type": "string",
          "default": "ghidra-mcp",
          "description": "Path to ghidra-mcp. Leave at default to auto-resolve or install via npm."
        },
        "ghidraLsp.mcpArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "ghidraLsp.requestTimeoutMs": {
          "type": "number",
          "default": 35000,
          "minimum": 100,
          "maximum": 300000
        },
        "ghidraLsp.liveRefreshIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 0,
          "description": "Refresh visible, unmodified functions from Ghidra at this interval. Set 0 to disable."
        },
        "ghidraLsp.templateArguments": {
          "type": "string",
          "enum": [
            "omit",
            "show"
          ],
          "enumDescriptions": [
            "Show C++ template argument lists as <…>; the full name stays in tooltips and hovers.",
            "Show complete template argument lists."
          ],
          "default": "omit",
          "description": "How demangled C++ names show template arguments."
        },
        "ghidraLsp.views.syncCursor": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Synchronize cursor selection across open Program Listing, Hex View, and Decompiler tabs for the same program."
        },
        "ghidraLsp.views.singleKeyShortcuts": {
          "type": "boolean",
          "default": true,
          "description": "Enable single-character shortcuts (/, g, +, =, -, 0) in Ghidra analysis webviews. Modifier shortcuts such as Ctrl+F (Cmd+F) and Ctrl+G (Cmd+G) stay active when off."
        }
      }
    },
    "keybindings": [
      {
        "key": "ctrl+.",
        "mac": "cmd+.",
        "command": "ghidraLsp.codeActions",
        "when": "resourceScheme == ghidra && editorTextFocus && editorLangId == ghidra-decompiled && !renameInputVisible"
      },
      {
        "key": "f2",
        "command": "ghidraLsp.renameSymbol",
        "when": "resourceScheme == ghidra && editorTextFocus && !renameInputVisible"
      },
      {
        "key": "ctrl+s",
        "mac": "cmd+s",
        "command": "ghidraLsp.saveRename",
        "when": "resourceScheme == ghidra && editorTextFocus && !renameInputVisible"
      }
    ],
    "submenus": [
      {
        "id": "ghidra.editor",
        "label": "Ghidra"
      },
      {
        "id": "ghidra.listing",
        "label": "Ghidra"
      }
    ],
    "menus": {
      "comments/commentThread/title": [
        {
          "command": "ghidraLsp.closeCommentEditor",
          "group": "navigation",
          "when": "commentController == ghidra-comments"
        }
      ],
      "comments/comment/title": [
        {
          "command": "ghidraLsp.editCommentText",
          "group": "inline",
          "when": "commentController == ghidra-comments && comment == ghidraComment"
        }
      ],
      "comments/comment/context": [
        {
          "command": "ghidraLsp.saveComment",
          "group": "inline@1",
          "when": "commentController == ghidra-comments && comment == ghidraComment"
        },
        {
          "command": "ghidraLsp.cancelCommentEdit",
          "group": "inline@2",
          "when": "commentController == ghidra-comments && comment == ghidraComment"
        }
      ],
      "commandPalette": [
        {
          "command": "ghidraLsp.browseSymbol",
          "when": "false"
        },
        {
          "command": "ghidraLsp.editCommentText",
          "when": "false"
        },
        {
          "command": "ghidraLsp.selectCommentKind",
          "when": "false"
        },
        {
          "command": "ghidraLsp.saveComment",
          "when": "false"
        },
        {
          "command": "ghidraLsp.cancelCommentEdit",
